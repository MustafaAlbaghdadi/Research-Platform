                                    <option value="1">في الانتظار</option>
                                    <option value="8">الحاضنة - موافقة</option>

                                    <option value="5">الرئاسه - طباعة</option>
                                    <option value="6">الرئاسة - موافقة</option>
                                    <option value="7">الرئاسة - رفض</option>
                                    <option value="9">المالية</option>

                                    break;

                            }

                        }


                    </select>
                </form>

            }


            @if (User.IsInRole(UserType.ITApprove))
            {
                <form id="statusSelect" asp-action="index" method="get">
                    <select name="select" class="form-select" aria-label="Default select example" onchange="{
                    document.getElementById('statusSelect').submit();

}">
                        @{
                            switch (queryVal)
                            {


                                case "5":
                                    <option value="8">الحاضنة - موافقة</option>
                                    <option selected value="5">الرئاسه - طباعة</option>
                                    <option value="6">الرئاسة - موافقة</option>
                                    <option value="7">الرئاسة - رفض</option>
                                    <option value="9">المالية</option>
                                    break;
                                case "6":
                                    <option value="8">الحاضنة - موافقة</option>
                                    <option value="5">الرئاسه - طباعة</option>
                                    <option selected value="6">الرئاسة - موافقة</option>
                                    <option value="7">الرئاسة - رفض</option>
                                    <option value="9">المالية</option>

                                    break;
                                case "7":
                                    <option value="8">الحاضنة - موافقة</option>
                                    <option value="5">الرئاسه - طباعة</option>
                                    <option value="6">الرئاسة - موافقة</option>
                                    <option selected value="7">الرئاسة - رفض</option>
                                    <option value="9">المالية</option>

                                    break;

                                case "8":
                                    <option value="8" selected>الحاضنة - موافقة</option>
                                    <option value="5">الرئاسه - طباعة</option>
                                    <option value="6">الرئاسة - موافقة</option>
                                    <option value="7">الرئاسة - رفض</option>
                                    <option value="9">المالية</option>

                                    break;
                                case "9":
                                    <option value="8">الحاضنة - موافقة</option>
                                    <option value="5">الرئاسه - طباعة</option>
                                    <option value="6">الرئاسة - موافقة</option>
                                    <option value="7">الرئاسة - رفض</option>
                                    <option value="9" selected>المالية</option>

                                    break;
                                default:
                                    <option value="8">الحاضنة - موافقة</option>
                                    <option value="5">الرئاسه - طباعة</option>
                                    <option value="6">الرئاسة - موافقة</option>
                                    <option value="7">الرئاسة - رفض</option>
