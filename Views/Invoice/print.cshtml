@model aspcore.Models.Invoice
@{
    Layout = "";

}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>وصل استلام مبلغ البحوث</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 0;
            margin: 0;
            box-sizing: border-box;
            direction: rtl;
            text-align: center;
        }

        .container {
            border: 2px solid #006600;
            width: 95%;
            margin: 5px auto;
            padding: 20px;
            box-sizing: border-box;
            font-size: 18px;
            line-height: 1.8;
            position: relative;
            height: 100%; /* Full height of the half A4 page */
        }

        .header {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .sub-header {
            font-size: 20px;
            color: #006600;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .content {
            text-align:justify-all;
            margin-top: 30px;
        }

        .line {
            padding:5px;
            display: inline-block;
           font-weight:bold;
            /* border-bottom: 1px solid black; */
            margin: 0 5px;
        }

        .signature-section {
            margin-top: 30px;
            display: flex;
            justify-content: space-between;
            text-align: center;
            font-size: 16px;
        }

        .signature-item {
            width: 30%;
        }

        .logo {
            width: 200px;
            position: absolute;
            top: 10px;
            left: 10px;
        }
        .qr{
            border: 2px solid #000;
            width: 150px;
            position: absolute;
            top: 15px;
            right: 15px;
        }

        /* Print Styling */
        @@media print {
            body {
                margin: 3px;
                padding: 0;
            }

            .container {
                width: 100%;
                height: 100%;
            }

            @@page {
                size: 148.5mm 210mm; /* Half of A4 in portrait mode */
                margin: 0.2in 0.2in 0 0.2in; /* Top, Right, Bottom, Left */
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div>
            <div >
            <img src="https://uomus.edu.iq/img/newsimages/WameedMUCNew_2023_4131550.jpg" alt="شعار الجامعة" class="logo">
            </div>
            
            <div >
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=http://res.uomus.edu.iq/showForm.aspx?res=@(ViewBag.id)&pass=@(ViewBag.id*2)" class="qr" />
            </div>

            <center>
                <div class="header">جامعة المستقبل</div>
                <div>قسم الحسابات والشؤون المالية</div>
                <div class="sub-header">وصل استلام مبلغ البحوث</div>
                <div>رقم الوصل (@Model.Id)</div>

            </center>

        </div>
      
       
        <div class="content">
            <p>
                أني <span class="line">@Model.Name</span> استلمت المبلغ وقدره <span class="line">@Model.Amount د.ع</span> فقط <span class="line">@Model.AmountString</span>
                وذلك عن مبلغ دعم البحث حسب الأمر الإداري <span class="line">@Model.OrderNumber</span>  بتاريخ <span class="line">@Model.OrderDate.ToString("yyyy-MM-dd")</span>.
            </p>
        </div>

        <div class="signature-section">
            <div class="signature-item">
                <p>اسم مدير التدقيق:</p>
                <p>التوقيع:</p>
            </div>
            <div class="signature-item">
                <p>اسم أمين الصندوق:</p>
                <p>التوقيع:</p>
            </div>
            <div class="signature-item">
                <p>اسم المستلم:</p>
                <p>التاريخ:</p>
                <p>التوقيع:</p>
            </div>
        </div>
    </div>
    <script>
        window.print();
    </script>
</body>
</html>
