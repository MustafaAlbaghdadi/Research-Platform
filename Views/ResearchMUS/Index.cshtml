    <div class="card-body">

        <table class="table">
            <thead>
                <tr>
                    <th class=col-1>

                    </th>

                    <th class=col-1 text-center>
                        نوع الامر
                    </th>

                    <th class=col-4>
                        @Html.DisplayNameFor(model => model.title)
                    </th>

                    @if (User.IsInRole(UserType.Admin) || User.IsInRole(UserType.ITApprove))
                    {
                        <th class="col-2">

                            @Html.DisplayNameFor(model => model.published)
                        </th>
                        <th class="col-1">
                            @Html.DisplayNameFor(model => model.quartile)
                        </th>
                        <th class="col-1">
                            @Html.DisplayNameFor(model => model.uploadDate)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Names)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Departments)
                        </th>
                    }
                    else if (User.IsInRole(UserType.President))
                    {
                        <th class="col-2">

                            @Html.DisplayNameFor(model => model.Names)
                        </th>
                        <th class="col-1">
                            @Html.DisplayNameFor(model => model.totalMoney)
                        </th>

                        <th class="col-1">
                            @Html.DisplayNameFor(model => model.PrintCount)
                        </th>

                    }
                    else if (User.IsInRole(UserType.Finance))
                    {
                        <th class="col-2">

                            @Html.DisplayNameFor(model => model.Names)
                        </th>
                        <th class="col-1">

                            @Html.DisplayNameFor(model => model.InvoiceId)
                        </th>
                        <th class="col-1">
                            @Html.DisplayNameFor(model => model.totalMoney)
                        </th>
                        <th>

                        </th>

                    }
                    <th class="col-3"></th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 0;
                    var pritClass = "";
                }
                @foreach (ResearchMUS item in Model)
                {
                    i++;

                    if (item.PrintCount > 0)
                    {
                        pritClass = "text-success";
                    }
                    else
                    {
                        pritClass = "";

                    }


                    <tr class="@pritClass">
                        <td>
                            @(i.ToString())
                        </td>
                        <td>
                            @if (item.OrderFormat == OrderFormat.ScopusCheckout)
                            {
                                <p class="alert alert-success text-center">امر صرف</p>
                            }
                            else
                            {
                                <p class="alert alert-danger text-center">امر تسوية</p>


                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.title)
                        </td>



                        @if (User.IsInRole(UserType.Admin) || User.IsInRole(UserType.ITApprove))
                        {
                            <td>
                                @(item.published == "0" ? "منشور" : "منشور ومفهرس")
                                @*                            @Html.DisplayFor(modelItem => item.published== "0"? "منشور" : "منشور ومفهرس")
                        *@
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.quartile)
                            </td>
                            <td>
                                @item.uploadDate.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Names)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Departments)
                            </td>
                            <td>
                                <a class="btn btn-outline-danger" asp-action="Review" asp-route-id="@item.Id">Review</a>
                            </td>
                        }
                        else if (User.IsInRole(UserType.President))
                        {
                            <td class="col-2">
                                @Html.DisplayFor(modelItem => item.Names)
                            </td>
                            <td class="col-1">
                                @Html.DisplayFor(modelItem => item.totalMoney)
                            </td>
                            <td>
                                @item.PrintCount
                            </td>



                            @if (item.checkState == "5" || item.checkState == "6")

                            {

                                <td>
                                    <a class="btn btn-outline-danger" asp-action="Review" asp-route-id="@item.Id">Review</a>
                                </td>
                            }
                            else
                            {
                                <td class="text-center ">
                                    <a class="btn btn-outline-secondary" asp-action="print" asp-route-id="@item.Id">طباعة</a>

                                    <a class="btn btn-outline-info" onclick="{
var res = confirm('هل تم توقيع الكتاب من رئيس الجامعة ؟');
                                    if(!res){
                                    return false;
}

}" asp-action="PresidentAprove" asp-route-id="@item.Id">موافق</a>




                                    <form id="reviewForm" class="d-inline" method="get" action="/ResearchMUS/presednetReject">
                                        <!-- Other form fields can go here -->

                                        <input type="hidden" id="rejectReasonInput" name="rejectReason">
                                        <input type="hidden" id="id" name="id" value="@item.Id">

                                        <!-- Button to trigger the prompt -->
                                        <input type="button" class="btn btn-outline-danger" value="رفض" onclick="handleRejectClick()">
                                    </form>

                                    <script>
                                        function handleRejectClick() {
                                            // Prompt the user for the reason
                                            var res = prompt('يرجى كتابة سبب الرفض');

                                            // Check if the response is not null or empty
                                            if (res != null && res.trim() !== '') {
                                                // Set the hidden input value
                                                document.getElementById('rejectReasonInput').value = res;

                                                // Submit the form
                                                document.getElementById('reviewForm').submit();
                                            } else {
                                                // Do nothing if the response is invalid
                                                return false;
                                            }
                                        }
                                    </script>

                                </td>


                            }




                        }
                        else if (User.IsInRole(UserType.Finance))
                        {
                            <td class="col-2">
                                @Html.DisplayFor(modelItem => item.Names)
                            </td>
                            <td class="col-1">
                                @Html.DisplayFor(modelItem => item.InvoiceId)
                            </td>

                            <td class="col-1">
                                @Html.DisplayFor(modelItem => item.totalMoney)
                            </td>

                            <td class=" col-4 text-center ">

                                @if (item.OrderFormat == OrderFormat.ScopusCheckout)
                                {
                                    <a class="btn btn-outline-secondary" asp-action="printInvoice" asp-route-id="@item.Id">طباعة</a>

                                    <form id="reviewForm" class="d-inline" method="post" enctype="multipart/form-data" action="/FinanceInvoiceApprove">
                                        <!-- Other form fields can go here -->

                                        <input type="file" hidden id="InvoiceFile" name="InvoiceFile">
                                        <input type="hidden" id="id" name="id" value="@item.Id">

                                        <!-- Button to trigger the prompt -->
                                        <input type="button" class="btn btn-outline-danger" value="موافق" onclick="uploadfile()">
                                    </form>

                                    <script>
                                        function uploadfile() {
                                            // Prompt the user for the reason
                                            var res = confirm('هل تم صرف البحث ؟ يرجى ارفاق الوصل');

                                            // Check if the response is not null or empty
                                            if (res == true  ) {
                                                 // Set the hidden input value
                                                var fileInput = document.getElementById('InvoiceFile');

                                                fileInput.hidden = false; // Unhide the file input temporarily

                                                fileInput.click();

                                                // Wait for the file input to change (file selected by the user)
                                                fileInput.addEventListener('change', function () {
                                                    // Submit the form after the file is selected
                                                    document.getElementById('reviewForm').submit();
                                                });
                                                // Submit the form
                                               // document.getElementById('reviewForm').submit();
                                            } else {
                                                // Do nothing if the response is invalid
                                                return false;
                                            }
                                        }
                                    </script>
                                }

                                else
                                {

                                    <a class="btn btn-danger" href="FinanceApprove?id=@item.Id">موافق</a>

                                }

                            </td>




                        }
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>