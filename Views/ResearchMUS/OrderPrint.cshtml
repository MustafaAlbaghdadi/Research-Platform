@{

    static string AddCommaBefore000(string number)
    {
        string numberString = number;
        int length = numberString.Length;

        // Insert comma before every "000" starting from the end
        for (int i = length - 3; i > 0; i -= 3)
        {
            numberString = numberString.Insert(i, ",");
        }

        return numberString;
    }
    string name = Model.Names.Split('\n')[0];
    string dep = Model.Departments.Split('\n')[0];
    string price = AddCommaBefore000(Model.totalMoney.ToString());

}
