                        </select>


                        <span asp-validation-for="SDGList" class="text-danger"></span>
                        </div>

                        <br />
                        <div class="form-group">
                        <label asp-for="totalMoney" class="control-label"></label>
                        <input required asp-for="totalMoney" class="form-control mt-2" type="number"></input>
                        <span asp-validation-for="totalMoney" class="text-danger"></span>
                        </div>*@

                    <br />
                    <center>
                        <input type="submit" value="Approve" class="btn btn-primary" />
                    </center>
                </form>
            </div>
        </div>
    </div>


</div>




