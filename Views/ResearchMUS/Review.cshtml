@model aspcore.Models.ResearchMUS

@{
    ViewData["Title"] = "Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="card-header">
    <h3 class="float-start">Review</h3>
    <p class="float-end">
        <a asp-action="Index" class="btn btn-outline-danger">Back</a>
    </p>
</div>




<div class="card-body">
    <table class="table">
        <thead>
            <tr>
                <th class=col-1>

                </th>
                <th class=col-1>
                    @Html.DisplayNameFor(model => model.ResearchersList.First().ResearcherLvl)

                </th>
                <th class="col-1">
                    @Html.DisplayNameFor(model => model.ResearchersList.First().ResearcherGender)
                </th>
                <th class=col-4>
                    @Html.DisplayNameFor(model => model.ResearchersList.First().ResearcherEnName)
                </th>

                <th class="col-5">
                    @Html.DisplayNameFor(model => model.ResearchersList.First().ResearcherArName)
                </th>
                <th class="col-5">
                    @Html.DisplayNameFor(model => model.ResearchersList.First().ResearcherMoney)
                </th>

            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ResearchersList)
            {
                <tr class="align-middle">
                    <td>

                        <a target="_blank" href="@item.img.Replace("~","https://uomus.edu.iq")">
                            <img class="rounded-circle" width="50" height="50" src="@item.img.Replace("~","https://uomus.edu.iq")" data-holder-rendered="true">
                        </a>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ResearcherLvl)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.ResearcherGender)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ResearcherEnName)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.ResearcherArName)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.ResearcherMoney)
                    </td>

                </tr>
            }
        </tbody>
    </table>

    <br />

    <br />
    <div class="row text-center">
        <div class="alert alert-success">

            <h4 class="m-0">
                @Model.totalMoney:المبلغ الكلي
            </h4>

            @if (Model.checkState == "7")
            {



                @*  <form asp-action="ChangeAmount" dir="rtl">
            <input type="hidden" asp-for="Id" />

            <br />
            <label asp-for="totalMoney">المبلغ</label>

            <input class="form-control" asp-for="totalMoney" />
            <br />
            <center>
            <input type="submit" value="حفظ" class="btn btn-primary" />
            </center>
            </form> *@
            }

        </div>



    </div>
    <div class="row">
        <div class="col-12 col-sm-7">

            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.title)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.title)
                </dd>

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.published)
                </dt>
                <dd class="col-sm-10">
                    @(Model.published == "0" ? "منشور" : "منشور ومفهرس")
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.pubDate)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.pubDate)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ISSNorEISSN)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ISSNorEISSN)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.journaltitle)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.journaltitle)
                </dd>

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.publisher)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.publisher)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.quartile)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.quartile)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.citeScore)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.citeScore)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.JournalCountry)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.JournalCountry)
                </dd>


                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.openAccess)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.openAccess)
                </dd>

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.appledPaper)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.appledPaper)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.code)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.code)
                </dd>

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.publisherEmail)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.publisherEmail)
                </dd>



                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ThanksOFcoll)
                </dt>
                <dd class="col-sm-10">
                    <input type="checkbox" checked="@Model.ThanksOFcoll" onclick="return false;" />
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ImpactFacter)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ImpactFacter)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ScientificrRcommendation)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ScientificrRcommendation)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ResFormId)
                </dt>
                <dd class="col-sm-10">
                    <a target="_blank" href="@Model.ResFormId">
                        رابط الطلب
                    </a>
                </dd>

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.OrderFormat)
                </dt>
                <dd class="col-sm-10">
                    @Model.OrderFormat
                </dd>


            </dl>



        </div>
        <div class="col-12 col-sm-5">
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.link)
                </dt>
                <dd class="col-sm-9">

                    <a target="_blank" href="@Html.DisplayFor(model => model.link)">
                        @Html.DisplayFor(model => model.link)
                    </a>
                </dd>
                <dt class="col-sm-3">

                    @Html.DisplayNameFor(model => model.journalurl)
                </dt>
                <dd class="col-sm-9">
                    <a target="_blank" href="@Html.DisplayFor(model => model.journalurl)">
                        @Html.DisplayFor(model => model.journalurl)
                    </a>
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.fileRes)
                </dt>
                <dd class="col-sm-9">

                    <a target="_blank" href="http://res.uomus.edu.iq/@Html.DisplayFor(model => model.fileRes)" class="btn btn-primary">
                        Download
                    </a>
                </dd>


                @if (Model.attachedFile1 != null && !string.IsNullOrWhiteSpace(Model.attachedFile1))
                {

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.attachedFile1)
                    </dt>
                    <dd class="col-sm-9">

                        <a target="_blank" href="http://res.uomus.edu.iq/@Html.DisplayFor(model => model.attachedFile1)" class="btn btn-primary">
                            Download
                        </a>
                    </dd>
                }


                @if (Model.attachedFile2 != null && !string.IsNullOrWhiteSpace(Model.attachedFile2))
                {

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.attachedFile2)
                    </dt>
                    <dd class="col-sm-9">

                        <a target="_blank" href="http://res.uomus.edu.iq/@Html.DisplayFor(model => model.attachedFile2)" class="btn btn-primary">
                            Download
                        </a>
                    </dd>
                }

                @if (Model.attachedFile3 != null && !string.IsNullOrWhiteSpace(Model.attachedFile3))
                {

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.attachedFile3)
                    </dt>
                    <dd class="col-sm-9">

                        <a target="_blank" href="http://res.uomus.edu.iq/@Html.DisplayFor(model => model.attachedFile3)" class="btn btn-primary">
                            Download
                        </a>
                    </dd>
                }


                @if (Model.attachedFile4 != null && !string.IsNullOrWhiteSpace(Model.attachedFile4))
                {

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.attachedFile4)
                    </dt>
                    <dd class="col-sm-9">

                        <a target="_blank" href="http://res.uomus.edu.iq/@Html.DisplayFor(model => model.attachedFile3)" class="btn btn-primary">
                            Download
                        </a>
                    </dd>
                }



                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.uploadDate)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.uploadDate)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.LastUpDate)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.LastUpDate)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.OtherResearch)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.OtherResearch)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ExtResrch)
                </dt>
                <dd class="col-sm-9">
                    <input type="checkbox" checked="@Model.ExtResrch" onclick="return false;" />
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ExtResrch_Local)
                </dt>
                <dd class="col-sm-9">
                    <input type="checkbox" checked="@Model.ExtResrch_Local" onclick="return false;" />

                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ExtResrch_Globl)
                </dt>
                <dd class="col-sm-9">
                    <input type="checkbox" checked="@Model.ExtResrch_Globl" onclick="return false;" />

                </dd>


                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.scopas)
                </dt>
                <dd class="col-sm-9">
                    <input type="checkbox" checked="@Model.scopas" onclick="return false;" />

                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.clarivate)
                </dt>
                <dd class="col-sm-9">
                    <input type="checkbox" checked="@Model.clarivate" onclick="return false;" />

                </dd>


                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Notes)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Notes)
                </dd>
            </dl>
        </div>

    </div>
    <center>

        <a target="_blank" href="http://res.uomus.edu.iq/showForm.aspx?res=@(Model.Id)&pass=@(Model.Id*2)" class="btn btn-primary">عرض الاستمارة</a>
        @if ( !string.IsNullOrWhiteSpace( Model.InvoiceFile) )
        {
            <a target="_blank" href="http://resadmin.uomus.edu.iq@(Model.InvoiceFile)" class="btn btn-primary">وصل الصرف</a>

           
           
        }
        
        @if (Model.checkState == "7")
        {
            if (Model.OrderFormat == OrderFormat.ScopusCheckout)
            {
                <a target="_blank" href="/ResearchMUS/OrderPrint/@Model.Id" class="btn btn-primary">امر صرف</a>

            }
            if (Model.OrderFormat == OrderFormat.ScopusSettlement)
            {
                <a target="_blank" href="/ResearchMUS/ScopusSettlementPrint/@Model.Id" class="btn btn-primary">امر تسوية</a>

            }
        }

    </center>

    <br />

    <div class="row ">

        <div class="card col-12 col-sm-5">
            <div class="card-header">
                Reject


            </div>
            <div class="card-body">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-group">
                        <label asp-for="RejectReason" class="control-label"></label>
                        <textarea asp-for="RejectReason" class="form-control mt-2" rows="3"><</textarea>
                        <span asp-validation-for="RejectReason" class="text-danger"></span>
                    </div>
                    <br />
                    <input type="submit" value="Reject" class="btn btn-danger" />

                </form>
            </div>
        </div>

        <div class="col-2 text-center d-sm-block d-none">
            <img width="150" src="https://uomus.edu.iq/assetsv2/img/logofooter.png" />
        </div>



        <div class="card col-12 col-sm-5">
            <div class="card-header">
                Approve


            </div>
            <div class="card-body">


                @{


                    switch (Model.checkState)
                    {
                        case "5":// upload Order File
                            <form asp-action="Approve" enctype="multipart/form-data" dir="rtl">
                                <input type="hidden" asp-for="Id" />

                                <br />


                                <div class="form-group">
                                    <label for="exampleInputEmail1">الامر الجامعي</label>
                                    <input type="file" class="form-control" id="OrderFile" name="OrderFile" required />

                                </div>


                                <div class="form-group mt-3">
                                    <label for="OrderNumber">العدد</label>
                                    <input type="text" id="OrderNumber" class="form-control" name="OrderNumber" required />

                                </div>

                                <div class="form-group mt-3">
                                    <label for="OrderDate">تاريخ الامر الجامعي</label>
                                    <input type="date" id="OrderDate" class="form-control" name="OrderDate" required />

                                </div>


                                <br />

                                <input type="submit" value="Approve" class="btn btn-primary" />

                               
                            </form>
                            <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                    const today = new Date().toISOString().split('T')[0];
                                    document.getElementById('OrderDate').value = today;
                                });
                            </script>

                            break;


                        case "7":// upload Order File
                            <form asp-action="ITApprove">
                                <input type="hidden" asp-for="Id" />

                                <br />
                                <center>

                                    <input type="submit" value="Approve" class="btn btn-primary" />
                                </center>
                            </form>


                            break;


                        case "1":



                            <form asp-action="ITApproveMustafa" dir="rtl">
                                <input type="hidden" asp-for="Id" />
                                <label asp-for="OrderFormat">فورمة الامر الجامعي</label>

                                <select class="form-select form-select-lg mb-3 text-center" asp-for="OrderFormat">
                                    @{
                                        switch (Model.OrderFormat)
                                        {
                                            case OrderFormat.ScopusCheckout:
                                                <option selected value="@OrderFormat.ScopusCheckout">امر صرف</option>
                                                <option value="@OrderFormat.ScopusSettlement">تسوية</option>
                                                break;
                                            case OrderFormat.ScopusSettlement:
                                                <option value="@OrderFormat.ScopusCheckout">امر صرف</option>
                                                <option selected value="@OrderFormat.ScopusSettlement">تسوية</option>

                                                break;
                                        }
                                    }


                                </select>

                                <br />
                                <label asp-for="totalMoney">المبلغ</label>

                                <input class="form-control" asp-for="totalMoney" />



                                @if (string.IsNullOrWhiteSpace(Model.ResFormId))
                                {
                                    <br />
                                    <label asp-for="ResFormId">رابط الاستمارة</label>

                                    <input class="form-control" required asp-for="ResFormId" />

                                }
                                <br />
                                <center>
                                    <input type="submit" value="الرئاسة - طباعة" class="btn btn-primary" />
                                </center>
                            </form>




                            <form asp-action="DirectApprove" dir="rtl">
                                <input type="hidden" asp-for="Id" />

                                <br />
                                <br />
                                <hr />
                                <br />
                                <center>
                                    <input type="submit" value="موافقة مباشرة" class="btn btn-danger" />
                                </center>
                            </form>
                            break;

                        case "6":// rejected resubmit
                            <form asp-action="ITApprove" dir="rtl">
                                <input type="hidden" asp-for="Id" />
                                <label asp-for="OrderFormat">فورمة الامر الجامعي</label>
                                <select class="form-select form-select-lg mb-3 text-center" asp-for="OrderFormat">
                                    @{
                                        switch (Model.OrderFormat)
                                        {
                                            case OrderFormat.ScopusCheckout:
                                                <option selected value="@OrderFormat.ScopusCheckout">امر صرف</option>
                                                <option value="@OrderFormat.ScopusSettlement">تسوية</option>
                                                break;
                                            case OrderFormat.ScopusSettlement:
                                                <option value="@OrderFormat.ScopusCheckout">امر صرف</option>
                                                <option selected value="@OrderFormat.ScopusSettlement">تسوية</option>

                                                break;
                                        }
                                    }
                                </select>

                                <br />
                                <label asp-for="totalMoney">المبلغ</label>

                                <input class="form-control" asp-for="totalMoney" />
                                <br />
                                <center>
                                    <input type="submit" value="الرئاسة - طباعة" class="btn btn-primary" />
                                </center>
                            </form>
                            break;
                    }
                }




            </div>
        </div>
    </div>


</div>




